@@ -2335,6 +2335,28 @@ class Parameter(ABC):
     @abstractmethod
     def add_to_parser(self, parser: _OptionParser, ctx: Context) -> None: ...
 
+    @contextmanager
+    def _with_parameter_source(
+        self, ctx: Context, source: ParameterSource
+    ) -> cabc.Iterator[None]:
+        """Expose ``source`` while processing a parameter.
+
+        The source is restored unless processing changed it explicitly. This
+        keeps sibling parameters from contaminating the final source recorded
+        for a parameter slot that they share.
+        """
+        previous_source = ctx._parameter_source.get(self.name)
+        ctx.set_parameter_source(self.name, source)
+
+        try:
+            yield
+        finally:
+            if ctx._parameter_source.get(self.name) is source:
+                if previous_source is None:
+                    del ctx._parameter_source[self.name]
+                else:
+                    ctx.set_parameter_source(self.name, previous_source)
+
     def consume_value(
         self, ctx: Context, opts: cabc.Mapping[str, t.Any]
     ) -> tuple[t.Any, ParameterSource]:
